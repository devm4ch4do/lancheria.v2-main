# Copie para .env e informe a senha do PostgreSQL local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lancheria
DB_USER=postgres
DB_PASSWORD=coloque_sua_senha_aqui

# Gere um token aleatório com pelo menos 32 caracteres para proteger a administração.
ADMIN_TOKEN=cole_seu_token_forte_aqui

# Ative a depuração apenas durante o desenvolvimento local.
FLASK_DEBUG=0
